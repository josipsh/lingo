# WhatsApp Cloud API
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=lingo-dev-verify-token
# Optional but recommended: App > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=

# Bot mode: conversation (real STT/LLM/TTS), echo_utterance, or echo_live
BOT_MODE=conversation

# ElevenLabs API (required for conversation mode)
ELEVENLABS_API_KEY=replace-me
# Voice ID from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI API (required for conversation mode)
OPENAI_API_KEY=replace-me
# Model: gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
OPENAI_MODEL=gpt-6-luna

# Server bind
HOST=0.0.0.0
PORT=7860
